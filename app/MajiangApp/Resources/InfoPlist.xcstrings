        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to pick a photo of a winning hand to read."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和了した手牌の写真を選んで読み取るために使います。"
