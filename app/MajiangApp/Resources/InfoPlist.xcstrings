    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "拍下和牌那家的牌，用来识别牌面和算番。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to photograph the winning hand so the tiles can be read and the fan counted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和了した手牌を撮影し、牌を読み取って番を計算するために使います。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍下和牌那家的牌，用來識別牌面和算番。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "从相册选一张和牌照片来识别。"
